{
  "name": "modo-missao-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Modo Missão para Windows",
  "author": "Modo Missão",
  "main": "main.js",
  "scripts": {
    "copy-web": "node -e \"require('fs').rmSync('www',{recursive:true,force:true});require('fs').cpSync('../www','www',{recursive:true})\"",
    "start": "npm run copy-web && electron .",
    "dist": "npm run copy-web && electron-builder --win nsis portable --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "br.modomissao.app",
    "productName": "Modo Missão",
    "files": [
      "main.js",
      "preload.js",
      "www/**/*",
      "build/icon.png",
      "build/tray.png"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Modo Missão",
      "artifactName": "ModoMissao-${version}-instalador.${ext}"
    },
    "portable": {
      "artifactName": "ModoMissao-${version}-portatil.exe"
    }
  }
}
